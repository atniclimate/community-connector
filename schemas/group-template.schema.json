{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://community-navigator.example.test/schemas/group-template/0.1.0",
  "description": "Authored group-template document (R2), parsed by cn-schema (cn_schema::types::GroupTemplate). Version semantics: this schema documents the 0.1 line. Instances carry schema_version; readers accept the same major - and, while the major is 0, the same minor (cn_model::accepts_schema) - and MUST reject unknown majors loudly (I7, I3). 0.1.1 adds the optional top-level `aliases` block (shape only, additive - D-093c/D-094c); matching logic lands with a later session. A breaking change to the shape bumps the major and mints a new $id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "template_id",
    "name",
    "description",
    "kinds",
    "edge_kinds"
  ],
  "$defs": {
    "accepted_schema_version": {
      "description": "schema_version accepted by 0.1-line readers: major 0, minor 1 (cn_model::accepts_schema).",
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    }
  },
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/accepted_schema_version"
    },
    "template_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "shape",
          "color_role",
          "attributes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "label": {
            "type": "string"
          },
          "shape": {
            "type": "string",
            "enum": [
              "sphere",
              "cube",
              "octahedron",
              "tetrahedron",
              "torus",
              "cone"
            ]
          },
          "color_role": {
            "type": "string",
            "pattern": "^kind-[1-9][0-9]*$"
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "type"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "number",
                    "enum",
                    "tags",
                    "date",
                    "geo",
                    "link",
                    "media"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "default_visibility": {
                  "type": "string",
                  "enum": [
                    "private",
                    "trusted",
                    "group",
                    "network",
                    "public"
                  ]
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "email",
                    "url"
                  ]
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "enum"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "required": [
                      "values"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "values"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "link"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {},
                  "else": {
                    "not": {
                      "required": [
                        "format"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "edge_kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "from",
          "to",
          "directed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "label": {
            "type": "string"
          },
          "from": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "to": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "directed": {
            "type": "boolean"
          },
          "weighted": {
            "type": "string",
            "enum": [
              "required",
              "optional",
              "forbidden"
            ]
          }
        }
      }
    },
    "aliases": {
      "description": "Optional term-normalization alias table (0.1.1, D-093c/D-094c). Shape only in this schema; matching runs in cn-ingest at plan-approval time only, never here and never in the app (Track B, discovery-2026-09-12.md). Each entry maps a set of as-written terms for one or more attribute ids to one canonical tag; the as-written term is always preserved (I6).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical",
          "attribute_ids",
          "terms"
        ],
        "properties": {
          "canonical": {
            "type": "string",
            "minLength": 1
          },
          "attribute_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "terms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "roles"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^kind-[1-9][0-9]*$": {
              "type": "string",
              "pattern": "^#[0-9a-f]{6}$"
            }
          }
        }
      }
    }
  }
}
