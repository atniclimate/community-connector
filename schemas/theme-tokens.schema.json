{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://community-navigator.example.test/schemas/theme-tokens/0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "theme", "report"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "tokens"],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1.0"
        },
        "tokens": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hex", "source"],
            "properties": {
              "hex": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              },
              "source": {
                "type": "string",
                "enum": ["template", "default", "adjusted"]
              }
            }
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "adjustments", "warnings"],
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "0.1.0"
        },
        "adjustments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["token", "from", "to", "reason"],
            "properties": {
              "token": { "type": "string" },
              "from": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
              "to": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
              "reason": { "type": "string" }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "tokens"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "tokens": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
