{
  "name": "community-navigator-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "spike": "vite --open /spike/index.html",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:smoke": "vite build --mode smoke --base ./",
    "test": "vitest run",
    "smoke:node": "node scripts/smoke-node.mjs",
    "validate:templates": "node scripts/validate-templates.mjs",
    "generate:demo": "node scripts/generate-demo-ops.mjs",
    "build:snapshot": "vite build --mode snapshot && node ../scripts/check-size.mjs dist/index.html"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "5.2.8",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.0",
    "@types/three": "^0.185.0",
    "3d-force-graph": "^1.80.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "three-forcegraph": "^1.43.4",
    "troika-three-text": "0.52.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
